#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

APP_NAME="termux-app-store"
CTL_NAME="tasctl"
INSTALL_DIR="$PREFIX/lib/.tas"
BIN_DIR="$PREFIX/bin"
REPO="djunekz/termux-app-store"
SENTINEL="$INSTALL_DIR/.installed"
SYMLINK="$BIN_DIR/$APP_NAME"
TASCTL_SYMLINK="$BIN_DIR/$CTL_NAME"
TASCTL_RAW="https://raw.githubusercontent.com/$REPO/master/tasctl"

PKG_REPO_URL="https://djunekz.github.io/termux-app-store"
PKG_KEY_URL="${PKG_REPO_URL}/termux-app-store.gpg"
PKG_KEYRING_DIR="${PREFIX}/etc/apt/keyrings"
PKG_KEYRING_FILE="${PKG_KEYRING_DIR}/termux-app-store.gpg"
PKG_REPO_ENTRY="deb [signed-by=${PKG_KEYRING_FILE}] ${PKG_REPO_URL} termux main"
PKG_SOURCES_DIR="${PREFIX}/etc/apt/sources.list.d"
PKG_SOURCES_FILE="${PKG_SOURCES_DIR}/tas.list"
PKG_KEY_FPRS="${TAS_KEY_FPR:-D39134A177717A5BEBEEAE7105D70CDBB6D80295}"

R=$'\033[0m'
B=$'\033[1m'
DIM=$'\033[2m'
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
CYAN=$'\033[36m'
MAGENTA=$'\033[35m'
BRED=$'\033[91m'
BGREEN=$'\033[92m'
BCYAN=$'\033[96m'

log()    { printf " %s[*]%s %s\n" "$CYAN$B" "$R" "$*"; }
ok()     { printf " %s[✔]%s %s\n" "$GREEN$B" "$R" "$*"; }
warn()   { printf " %s[!]%s %s\n" "$YELLOW$B" "$R" "$*" >&2; }
err()    { printf " %s[✗]%s %s\n" "$RED$B" "$R" "$*" >&2; exit 1; }
info()   { printf "     %s%s%s\n" "$DIM" "$*" "$R"; }
step()   { printf "\n %s→%s %s\n" "$MAGENTA$B" "$R" "$*"; }
header() {
  local title="$1"
  local line
  line=$(printf '─%.0s' $(seq 1 ${#title}))
  printf "\n%s%s%s\n%s%s%s\n" "$CYAN$B" "$title" "$R" "$DIM" "$line" "$R"
}

banner() {
  printf "\n%s" "$CYAN$B"
  printf "       ████████╗ █████╗ ███████╗\n"
  printf "          ██╔══╝██╔══██╗██╔════╝\n"
  printf "          ██║   ███████║███████╗ \n"
  printf "          ██║   ██╔══██║╚════██║\n"
  printf "          ██║   ██║  ██║███████║\n"
  printf "          ╚═╝   ╚═╝  ╚═╝╚══════╝\n"
  printf "%s" "$R"
  printf "       %sTermux App Store Controller%s\n" "$DIM$YELLOW" "$R"
  printf "               %sby %s@djunekz%s\n\n" "$DIM$YELLOW" "$GREEN" "$R"
}

verify_official_source() {
  log "Verifying official source..."

  local api_full_name
  api_full_name=$(curl -fsSL \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/$REPO" 2>/dev/null \
    | grep '"full_name"' \
    | head -1 \
    | sed 's/.*"full_name": *"\([^"]*\)".*/\1/' || true)

  if [[ "$api_full_name" != "$REPO" ]]; then
    printf "\n"
    printf "%s╔══════════════════════════════════════════════════════════╗%s\n" "$BRED$B" "$R"
    printf "%s║                                                          ║%s\n" "$BRED$B" "$R"
    printf "%s║   ⚠  BLOCKED — UNOFFICIAL / MODIFIED SOURCE  ⚠           ║%s\n" "$BRED$B" "$R"
    printf "%s║                                                          ║%s\n" "$BRED$B" "$R"
    printf "%s║   This tool only works with the official project:        ║%s\n" "$BRED$B" "$R"
    printf "%s║   github.com/djunekz/termux-app-store                    ║%s\n" "$BRED$B" "$R"
    printf "%s║                                                          ║%s\n" "$BRED$B" "$R"
    printf "%s║   Any fork or renamed copy is NOT the official           ║%s\n" "$BRED$B" "$R"
    printf "%s║   Termux App Store by @djunekz.                          ║%s\n" "$BRED$B" "$R"
    printf "%s║                                                          ║%s\n" "$BRED$B" "$R"
    printf "%s║   Get the real one:                                      ║%s\n" "$BRED$B" "$R"
    printf "%s║                                                          ║%s\n" "$BRED$B" "$R"
    printf "%s╚══════════════════════════════════════════════════════════╝%s\n" "$BRED$B" "$R"
    printf "%sCopy this text command for installing termux-app-store:%s\n\n" "$BRED$B" "$R"
    printf "%s curl -fsSL https://raw.githubusercontent.com/djunekz/termux-app-store/master/tasctl | bash -s install%s\n" "$BGREEN$B" "$R"
    printf "\n"
    exit 1
  fi

  ok "Official source verified: ${B}github.com/$REPO${R}"
}

get_installed_version() {
  if [[ -f "$SENTINEL" ]]; then
    local ver
    ver=$(grep '^version=' "$SENTINEL" 2>/dev/null | cut -d= -f2 || true)
    [[ -n "$ver" ]] && echo "$ver" && return
  fi

  if [[ -f "$INSTALL_DIR/termux_app_store/main.py" ]]; then
    local ver
    ver=$(grep -oP 'APP_VERSION\s*=\s*"\K[0-9.]+' \
      "$INSTALL_DIR/termux_app_store/main.py" 2>/dev/null | head -1 || true)
    [[ -n "$ver" ]] && echo "$ver" && return
  fi

  local ver
  ver=$(python3 -c "import importlib.metadata; print(importlib.metadata.version('termux-app-store'))" 2>/dev/null || true)
  [[ -n "$ver" ]] && echo "$ver" && return

  echo "unknown"
}

get_install_mode() {
  if [[ -f "$SENTINEL" ]]; then
    local mode
    mode=$(grep '^mode=' "$SENTINEL" 2>/dev/null | cut -d= -f2 || echo "")
    [[ -n "$mode" ]] && echo "$mode" && return
  fi
  if python3 -c "import importlib.util; s=importlib.util.find_spec('termux_app_store'); exit(0 if s and 'site-packages' in (s.origin or '') else 1)" 2>/dev/null; then
    echo "pip"
    return
  fi
  if [[ -f "$INSTALL_DIR/termux_app_store/main.py" ]]; then
    echo "source"
    return
  fi
  echo "unknown"
}

is_installed() {
  [[ -f "$INSTALL_DIR/termux_app_store/main.py" ]]
}

write_sentinel() {
  local ver="$1" mode="$2"
  mkdir -p "$INSTALL_DIR"
  cat > "$SENTINEL" << EOF
version=$ver
mode=$mode
installed_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
EOF
}

create_wrapper() {
  local ver="$1"

  {
    printf '#!/data/data/com.termux/files/usr/bin/bash\n'
    printf 'export TERMUX_APP_STORE_VERSION="%s"\n' "$ver"
    printf 'export TERMUX_APP_STORE_HOME="%s"\n' "$INSTALL_DIR"
    printf '\n'
    printf 'exec python3 "%s/termux_app_store/main.py" "$@"\n' "$INSTALL_DIR"
  } > "$SYMLINK"

  chmod +x "$SYMLINK"
  ok "Wrapper created: $SYMLINK"
}

verify_pkg_key() {
  python3 - "$1" "${PKG_KEY_FPRS// /}" <<'PYEOF'
import hashlib, sys

path, pins = sys.argv[1], [p.upper() for p in sys.argv[2].split(",") if p]
ALLOWED = (2, 6, 13, 14, 17)

def fail(msg):
    print(msg)
    sys.exit(1)

data = open(path, "rb").read()
if len(data) > 65536:
    fail("key file is too large")
if data.startswith(b"-----BEGIN"):
    fail("key is ASCII-armored, a binary key is required")

packets, pos, n = [], 0, len(data)
try:
    while pos < n:
        hdr = data[pos]
        pos += 1
        if not hdr & 0x80:
            fail("not an OpenPGP packet stream")
        if hdr & 0x40:
            tag = hdr & 0x3F
            first = data[pos]
            if first < 192:
                length, pos = first, pos + 1
            elif first < 224:
                length, pos = ((first - 192) << 8) + data[pos + 1] + 192, pos + 2
            elif first == 255:
                length, pos = int.from_bytes(data[pos + 1:pos + 5], "big"), pos + 5
            else:
                fail("unsupported packet length encoding")
        else:
            tag = (hdr >> 2) & 0x0F
            kind = hdr & 0x03
            if kind == 3:
                fail("unsupported packet length encoding")
            size = (1, 2, 4)[kind]
            length = int.from_bytes(data[pos:pos + size], "big")
            pos += size
        if pos + length > n:
            fail("truncated key file")
        packets.append((tag, data[pos:pos + length]))
        pos += length
except IndexError:
    fail("truncated key file")

if not packets or packets[0][0] != 6:
    fail("file does not start with a public key")

keys, primaries = [], 0
for tag, body in packets:
    if tag not in ALLOWED:
        fail("unexpected OpenPGP packet type %d" % tag)
    if tag in (6, 14):
        if not body or body[0] != 4 or len(body) > 0xFFFF:
            fail("only version 4 public keys are supported")
        fpr = hashlib.sha1(b"\x99" + len(body).to_bytes(2, "big") + body).hexdigest().upper()
        if tag == 6:
            primaries += 1
            keys.append(("Key", fpr))
        else:
            keys.append(("Subkey", fpr))

if primaries != 1:
    fail("file must contain exactly one primary key")
if keys[0][1] not in pins:
    fail("key fingerprint %s does not match the pinned fingerprint" % keys[0][1])

for kind, fpr in keys:
    print(kind, fpr)
PYEOF
}

install_pkg_key() {
  step "Installing repository signing key..."
  info "Key   : $PKG_KEY_URL"
  info "File  : $PKG_KEYRING_FILE"

  command -v curl >/dev/null 2>&1 || pkg install -y curl || err "Failed to install curl"
  command -v python3 >/dev/null 2>&1 || pkg install -y python || err "Failed to install python"

  mkdir -p "$PKG_KEYRING_DIR"
  local tmp report
  tmp=$(mktemp "${PKG_KEYRING_DIR}/.tas-key-XXXXXX") || err "Cannot create temp file"

  if ! curl -fsSL --max-filesize 65536 -o "$tmp" "$PKG_KEY_URL"; then
    rm -f "$tmp"
    err "Could not download signing key (repository NOT added)"
  fi

  if ! report=$(verify_pkg_key "$tmp" 2>&1); then
    rm -f "$tmp"
    err "Signing key rejected: $report"
  fi

  local kind fpr
  while read -r kind fpr; do
    info "$kind: $fpr"
  done <<< "$report"
  ok "Key matches the pinned fingerprint"

  chmod 644 "$tmp"
  mv -f "$tmp" "$PKG_KEYRING_FILE"
  ok "Key installed: $PKG_KEYRING_FILE"
}

add_pkg_repo() {
  step "Adding apt repository..."
  info "Entry : $PKG_REPO_ENTRY"
  info "File  : $PKG_SOURCES_FILE"

  mkdir -p "$PKG_SOURCES_DIR"

  if [[ -f "$PKG_SOURCES_FILE" ]] && grep -q "trusted=yes" "$PKG_SOURCES_FILE" 2>/dev/null; then
    warn "Old insecure entry ([trusted=yes]) found -- migrating to signed-by"
  fi

  install_pkg_key

  printf "%s\n" "$PKG_REPO_ENTRY" > "$PKG_SOURCES_FILE"
  ok "Repository added: $PKG_SOURCES_FILE"
}

remove_pkg_repo() {
  step "Removing apt repository..."
  local f
  for f in "$PKG_SOURCES_FILE" "$PKG_KEYRING_FILE"; do
    if [[ -f "$f" ]]; then
      rm -f "$f"
      ok "Removed: $f"
    else
      warn "File not found: $f"
    fi
  done
}

install_app_source() {
  local mode="${1:-install}"

  step "Checking dependencies..."

  if ! command -v git >/dev/null 2>&1; then
    info "Installing git..."
    pkg install -y git || err "Failed to install git"
  fi
  ok "git found: $(git --version)"

  if ! command -v python3 >/dev/null 2>&1 && ! command -v python >/dev/null 2>&1; then
    info "Installing python..."
    pkg install -y python || err "Failed to install python"
  fi
  ok "python found: $(python3 --version 2>/dev/null || python --version)"

  local _py
  _py=$(command -v python3 2>/dev/null || command -v python)
  if ! "$_py" -c "import textual" >/dev/null 2>&1; then
    info "Installing textual..."
    "$_py" -m pip install textual --break-system-packages -q \
      || err "Failed to install textual"
  fi
  ok "textual found"

  step "Cloning repository..."
  info "Repo  : https://github.com/$REPO.git"
  info "Target: $INSTALL_DIR"

  mkdir -p "$(dirname "$INSTALL_DIR")"

  if [[ -d "$INSTALL_DIR" ]]; then
    local backup_dir
    backup_dir="${INSTALL_DIR}.bak.$(date +%s)"
    mv "$INSTALL_DIR" "$backup_dir"
    info "Existing install backed up to: $backup_dir"
  fi

  git clone --depth=1 "https://github.com/$REPO.git" "$INSTALL_DIR" \
    || err "Failed to clone repository"
  ok "Repository cloned to $INSTALL_DIR"

  rm -f "$INSTALL_DIR/$APP_NAME"

  add_pkg_repo

  step "Detecting installed version..."
  local ver
  ver=$(grep -oP '__version__\s*=\s*"\K[0-9.]+' \
    "$INSTALL_DIR/termux_app_store/__init__.py" 2>/dev/null \
    | head -1 || echo "unknown")
  info "Version: $ver"

  write_sentinel "$ver" "source"

  step "Creating wrapper..."
  create_wrapper "$ver"

  if [[ -f "$INSTALL_DIR/tasctl" ]]; then
    chmod +x "$INSTALL_DIR/tasctl"
    ln -sf "$INSTALL_DIR/tasctl" "$TASCTL_SYMLINK"
    ok "tasctl symlinked: $TASCTL_SYMLINK → $INSTALL_DIR/tasctl"
  fi

  printf "\n%s  ✔ %s v%s %sed successfully!%s\n" \
    "$GREEN$B" "$APP_NAME" "$ver" "$mode" "$R"
  info "Run with  : ${CYAN}$APP_NAME${R}"
  info "Source at : ${DIM}$INSTALL_DIR${R}"
  info "Apt repo  : ${DIM}$PKG_REPO_URL${R}"
  info "Update    : ${DIM}tasctl update${R}"
  printf "\n"
}

uninstall_app() {
  banner
  header "Uninstall"

  if ! is_installed && [[ ! -L "$SYMLINK" ]] && [[ ! -f "$SYMLINK" ]]; then
    warn "$APP_NAME is not installed."
    return
  fi

  local imode
  imode=$(get_install_mode)
  info "Detected mode: $imode"

  step "Removing wrapper/symlink..."
  rm -f "$SYMLINK"
  ok "Removed: $SYMLINK"

  step "Removing installation directory..."
  rm -rf "$INSTALL_DIR"
  ok "Removed: $INSTALL_DIR"

  remove_pkg_repo

  printf "\n%s  ✔ %s uninstalled successfully.%s\n\n" "$GREEN$B" "$APP_NAME" "$R"
}

cmd_doctor() {
  banner
  header "Environment Diagnosis"

  local all_ok=true

  printf "\n %sArchitecture%s\n" "$B" "$R"
  local arch
  arch=$(uname -m)
  ok "Architecture: $arch"

  printf "\n %sPython%s\n" "$B" "$R"
  if command -v python3 >/dev/null 2>&1; then
    ok "$(python3 --version)"
    info "$(which python3)"
  elif command -v python >/dev/null 2>&1; then
    ok "$(python --version)"
    info "$(which python)"
  else
    warn "Python not found"
    info "Fix: pkg install python"
    all_ok=false
  fi

  printf "\n %spip%s\n" "$B" "$R"
  if python3 -m pip --version >/dev/null 2>&1; then
    ok "$(python3 -m pip --version | awk '{print $1,$2}')"
  elif command -v pip3 >/dev/null 2>&1; then
    ok "$(pip3 --version | awk '{print $1,$2}')"
  else
    warn "pip not found"
    info "Fix: pkg install python"
    all_ok=false
  fi

  printf "\n %sTextual (TUI framework)%s\n" "$B" "$R"
  if python3 -c "import textual" >/dev/null 2>&1; then
    local txt_ver
    txt_ver=$(python3 -c "import textual; print(textual.__version__)" 2>/dev/null)
    ok "textual v$txt_ver"
  else
    warn "Textual not found"
    info "Fix: python3 -m pip install textual --break-system-packages"
    all_ok=false
  fi

  printf "\n %scurl%s\n" "$B" "$R"
  if command -v curl >/dev/null 2>&1; then
    ok "$(curl --version | head -1 | awk '{print $1,$2}')"
  else
    warn "curl not found"
    info "Fix: pkg install curl"
    all_ok=false
  fi

  printf "\n %s%s installation%s\n" "$B" "$APP_NAME" "$R"
  if is_installed; then
    local inst_ver imode
    inst_ver=$(get_installed_version)
    imode=$(get_install_mode)
    ok "Installed: $INSTALL_DIR"
    info "Version : $inst_ver"
    info "Mode    : $imode"
    if [[ "$imode" == "source" ]]; then
      [[ -f "$INSTALL_DIR/termux_app_store/main.py" ]] \
        && ok "Termux App Store OK" || { warn "Termux App Store missing"; all_ok=false; }
    fi
    [[ -f "$SYMLINK" ]] || [[ -L "$SYMLINK" ]] \
      && ok "Wrapper OK: $SYMLINK" \
      || { warn "Wrapper missing: $SYMLINK"; info "Fix: run install.sh again"; all_ok=false; }
    [[ -f "$SENTINEL" ]] && ok "Sentinel OK" || warn "Sentinel missing (install info not found)"

    printf "\n %sTERMUX_APP_STORE_HOME in wrapper%s\n" "$B" "$R"
    if grep -q 'TERMUX_APP_STORE_HOME' "$SYMLINK" 2>/dev/null; then
      ok "TERMUX_APP_STORE_HOME is set in wrapper"
    else
      warn "TERMUX_APP_STORE_HOME missing from wrapper"
      info "Fix: tasctl update"
      all_ok=false
    fi
  else
    warn "$APP_NAME not installed"
    info "Fix: $CTL_NAME install"
    all_ok=false
  fi

  printf "\n %sTERMUX_APP_STORE_HOME (env)%s\n" "$B" "$R"
  if [[ -n "${TERMUX_APP_STORE_HOME:-}" ]]; then
    if [[ -d "$TERMUX_APP_STORE_HOME/packages" ]]; then
      ok "Set and valid: $TERMUX_APP_STORE_HOME"
    else
      warn "Set but invalid: $TERMUX_APP_STORE_HOME"
      all_ok=false
    fi
  else
    info "Not set in current shell (set via wrapper)"
  fi

  printf "\n%s%s%s\n" "$DIM" "$(printf '─%.0s' $(seq 1 42))" "$R"
  if $all_ok; then
    printf " %s✔ All checks passed. Environment looks good!%s\n\n" "$GREEN$B" "$R"
  else
    printf " %s! Some issues found. See above for fixes.%s\n\n" "$YELLOW$B" "$R"
  fi
}

cmd_self_update() {
  banner
  header "Self-Update tasctl"

  step "Fetching latest tasctl from GitHub..."
  info "Source: $TASCTL_RAW"

  local tmp
  tmp=$(mktemp)

  if curl -fsSL "$TASCTL_RAW" -o "$tmp"; then
    chmod +x "$tmp"
    if head -1 "$tmp" | grep -q "bash"; then
      mv "$tmp" "$TASCTL_SYMLINK"
      ok "tasctl updated successfully!"
      info "Location: $TASCTL_SYMLINK"
    else
      rm -f "$tmp"
      err "Downloaded file does not look like a valid bash script."
    fi
  else
    rm -f "$tmp"
    err "Failed to download tasctl. Check your internet connection."
  fi

  printf "\n"
}

usage() {
  banner
  printf "%sUSAGE%s\n" "$CYAN$B" "$R"
  printf "  %s%s%s %s<command> [options]%s\n\n" "$CYAN" "$CTL_NAME" "$R" "$B" "$R"

  printf "%sCOMMANDS%s\n" "$CYAN$B" "$R"
  printf "  %sinstall%s           Install Termux App Store (from source)\n" "$GREEN$B" "$R"
  printf "  %supdate%s            Update to latest version (from source)\n" "$GREEN$B" "$R"
  printf "  %suninstall%s         Remove Termux App Store\n" "$GREEN$B" "$R"
  printf "  %sinstall-repo%s      Add pkg apt repository only\n" "$GREEN$B" "$R"
  printf "  %suninstall-repo%s    Remove pkg apt repository only\n" "$GREEN$B" "$R"
  printf "  %sdoctor%s            Diagnose environment\n" "$GREEN$B" "$R"
  printf "  %sself-update%s       Update tasctl itself\n" "$GREEN$B" "$R"
  printf "  %shelp%s              Show this help\n" "$GREEN$B" "$R"

  printf "\n%sEXAMPLES%s\n" "$CYAN$B" "$R"
  printf "  %s%s install%s\n" "$DIM" "$CTL_NAME" "$R"
  printf "  %s%s update%s\n" "$DIM" "$CTL_NAME" "$R"
  printf "  %s%s doctor%s\n" "$DIM" "$CTL_NAME" "$R"
  printf "  %s%s self-update%s\n" "$DIM" "$CTL_NAME" "$R"
  printf "\n"
}

cmd_update() {
  banner
  header "Update"

  local imode
  imode=$(get_install_mode)

  if [[ "$imode" == "pip" ]]; then
    step "Pip mode detected — upgrading via pip..."
    local old_ver new_ver
    old_ver=$(get_installed_version)
    python3 -m pip install --upgrade termux-app-store --break-system-packages \
      || err "pip upgrade failed"
    new_ver=$(python3 -c "import importlib.metadata; print(importlib.metadata.version('termux-app-store'))" 2>/dev/null || echo "unknown")

    if [[ -f "$SENTINEL" ]]; then
      sed -i "s/^version=.*/version=$new_ver/" "$SENTINEL"
      sed -i "s/^mode=.*/mode=pip/" "$SENTINEL"
    else
      write_sentinel "$new_ver" "pip"
    fi

    if [[ -f "$SYMLINK" ]]; then
      sed -i "s/export TERMUX_APP_STORE_VERSION=\"[^\"]*\"/export TERMUX_APP_STORE_VERSION=\"$new_ver\"/" "$SYMLINK"
    fi

    ok "termux-app-store upgraded: $old_ver → $new_ver"
    printf "\n%s  ✔ termux-app-store v%s updated successfully!%s\n\n" "$GREEN$B" "$new_ver" "$R"
    return
  fi

  install_app_source "update"
}

cmd="${1:-help}"
flag="${2:-}"

case "$cmd" in
  help|-h|--help) : ;;
  *) verify_official_source ;;
esac

case "$cmd" in
  install)
    banner
    header "Install"
    install_app_source "install"
    ;;
  update)
    cmd_update
    ;;
  uninstall)
    uninstall_app
    ;;
  install-repo)
    banner
    header "Add Repository"
    add_pkg_repo
    step "Running pkg update..."
    if pkg update; then
      printf "\n%s  ✔ Repository added. Run: pkg install <package>%s\n\n" "$GREEN$B" "$R"
    else
      warn "Repository added, but pkg update failed — fix the error above, then run: pkg update"
      exit 1
    fi
    ;;
  uninstall-repo)
    banner
    header "Remove Repository"
    remove_pkg_repo
    step "Running pkg update..."
    pkg update || warn "pkg update failed — run manually: pkg update"
    printf "\n%s  ✔ Repository removed.%s\n\n" "$GREEN$B" "$R"
    ;;
  doctor)
    cmd_doctor
    ;;
  self-update|selfupdate)
    cmd_self_update
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    err "Unknown command: '$cmd'  →  Run: $CTL_NAME help"
    ;;
esac
